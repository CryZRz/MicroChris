{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MicroChris",
  "version": "0.1.3",
  "identifier": "dev.avrstudio.lite",
  "build": {
    "beforeDevCommand": "npm start -- --port 4200",
    "devUrl": "http://localhost:4200",
    "beforeBuildCommand": "npm run tools:prepare && npm run build",
    "frontendDist": "../dist/avr-studio-lite/browser"
  },
  "app": {
    "windows": [
      {
        "title": "MicroChris",
        "width": 1400,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "dangerousDisableAssetCspModification": ["style-src"],
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; img-src 'self' data:; worker-src 'self' blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["toolchain/**/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Desktop IDE for assembly projects.",
    "longDescription": "MicroChris is a desktop IDE for writing, building, and uploading assembly programs to Arduino boards.",
    "publisher": "MicroChris",
    "category": "DeveloperTool"
  }
}
